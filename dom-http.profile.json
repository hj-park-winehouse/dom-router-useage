{
  "schemaVersion": 1,
  "profileId": "review-dom-http",
  "revision": 1,
  "engineMajor": 1,
  "name": "Review · DOM → HTTP",
  "description": "Local synthetic DOM data only. No business submissions.",
  "enabled": false,
  "channel": "demo",
  "carrier": "GENERIC",
  "connectionRef": "local-http-demo",
  "origins": [
    "http://127.0.0.1:19494"
  ],
  "flows": [
    {
      "id": "read-review-http",
      "name": "Click → read → send",
      "source": {
        "type": "dom.event",
        "origin": "http://127.0.0.1:19494",
        "event": "click",
        "selector": "#send-http",
        "requireTrustedClick": true,
        "reads": [
          {
            "name": "document-id",
            "selector": "#document-id",
            "read": "value",
            "maxLength": 100
          },
          {
            "name": "recipient",
            "selector": "#recipient",
            "read": "text",
            "maxLength": 200
          }
        ]
      },
      "steps": [
        {
          "id": "read-fields",
          "type": "extract.fields",
          "fields": [
            {
              "name": "documentId",
              "from": "/dom/document-id"
            },
            {
              "name": "recipient",
              "from": "/dom/recipient"
            }
          ]
        },
        {
          "id": "emit-review",
          "type": "emit.event",
          "eventType": "diagnostic.observed",
          "bindings": {
            "/documentId": "/vars/documentId",
            "/recipient": "/vars/recipient"
          }
        }
      ]
    }
  ]
}
